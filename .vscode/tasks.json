{
  // Terminal > Run Task. Commands assume macOS/Linux; see the "windows" overrides.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Terrabots: Setup venv",
      "type": "shell",
      "command": "python3 -m venv .venv && .venv/bin/pip install -e '.[dev]'",
      "windows": {
        "command": "py -m venv .venv; .venv\\Scripts\\pip install -e '.[dev]'"
      },
      "problemMatcher": []
    },
    {
      "label": "Terrabots: Run tests",
      "type": "shell",
      "command": "${command:python.interpreterPath} -m pytest -q",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "Terrabots: Open viewer in browser",
      "type": "shell",
      "command": "python3 -m webbrowser http://localhost:8765/",
      "windows": { "command": "start http://localhost:8765/" },
      "problemMatcher": []
    }
  ]
}
